{
  "name": "groomi",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "productName": "Groomi",
  "main": "dist-electron/main.js",
  "scripts": {
    "test:release": "pnpm electron:build && node --test tests/release-safety.test.mjs",
    "test:ui": "pnpm build && node scripts/run-electron-test.mjs",
    "test:packaged": "node scripts/run-electron-test.mjs --packaged",
    "build": "pnpm electron:build && react-router build",
    "dist:win": "pnpm build && electron-builder --win nsis",
    "dev": "pnpm electron:build && concurrently \"vite\" \"cross-env BROWSER=none electron dist-electron/main.js\"",
    "start": "pnpm electron:build && concurrently \"vite\" \"cross-env BROWSER=none electron dist-electron/main.js\"",
    "electron:build": "tsc -p tsconfig.electron.json",
    "typecheck": "react-router typegen && tsc && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@react-router/node": "7.15.0",
    "@react-router/serve": "7.15.0",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extensions": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "axios": "^1.16.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "framer-motion": "^12.40.0",
    "isbot": "^5.1.36",
    "jy-headless": "^0.4.1",
    "ollama": "^0.6.3",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-router": "7.15.0",
    "sqlite3": "^6.0.1",
    "tailwind-variants": "^3.2.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  },
  "build": {
    "appId": "com.groomi.app",
    "afterPack": "scripts/after-pack.mjs",
    "directories": {
      "output": "release"
    },
    "artifactName": "groomi-${version}.${ext}",
    "files": [
      "assets/app-logo.ico",
      "assets/app-logo.png",
      "assets/fonts/**/*",
      "build/client/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-logo.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app-logo.ico",
      "uninstallerIcon": "assets/app-logo.ico",
      "installerHeaderIcon": "assets/app-logo.ico"
    }
  }
}
